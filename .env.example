# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋 금지(.gitignore 처리됨).
# compose 파일이 이 디렉터리에 있으므로 .env 도 여기 있어야 읽힌다.

# ── 포트 (로컬에서 충돌할 때만 바꾼다) ──
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
BACKEND_PORT=8080
AI_PORT=8000

# ── 필수: 없으면 백엔드 컨테이너가 안 뜬다 ──
# 아무 긴 랜덤 문자열이면 된다. 예) openssl rand -hex 32
PHONE_VERIFICATION_HMAC_SECRET=replace-with-a-long-random-secret

# 라이브(LiveKit). 라이브 기능을 안 쓸 거면 빈 값 그대로 둔다
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── 백엔드 ↔ AI 서명키. 양쪽이 같은 값을 써야 하고 서로는 달라야 한다 ──
# 백엔드 → AI 요청 서명
DIB_SERVICE_HMAC_SECRET=replace-with-a-long-random-secret
# AI → 백엔드 콜백 서명
DIB_AI_HMAC_SECRET=replace-with-another-long-random-secret

# ── 선택 ──
# TossPayments 테스트 시크릿 키 (developers.tosspayments.com > 내 개발정보)
TOSS_SECRET_KEY=test_sk_replace_me
# 배송 조회: fake | deliverytracker | sweettracker
CARRIER_PROVIDER=fake
DELIVERY_TRACKER_CLIENT_ID=
DELIVERY_TRACKER_CLIENT_SECRET=
SWEETTRACKER_KEY=
PASSWORD_RESET_PAGE_URL=http://localhost:5173/password/reset
# 상품 검수 2차 AI. 둘 중 하나만 있어도 동작하고, 없으면 금칙어 필터만 돈다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
